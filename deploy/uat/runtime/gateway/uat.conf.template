upstream uat_auth { server uat-auth:9999; }

upstream uat_rest { server uat-rest:3000; }

upstream uat_web { server uat-web:3000; }

map "$http_origin" $uat_origin_ok {
    "default" "0";
    "" "1";
    "~^https://people\\-hub\\-uat\\.srv1866578\\.hstgr\\.cloud$" "1";
}

map "$http_origin" $uat_cors_origin {
    "default" "";
    "~^https://people\\-hub\\-uat\\.srv1866578\\.hstgr\\.cloud$" "$http_origin";
}

map "$request_method:$http_origin" $uat_preflight_origin_ok {
    "default" "1";
    "OPTIONS:" "0";
}

map "$request_method" $uat_policy_method {
    "default" "$request_method";
    "OPTIONS" "$http_access_control_request_method";
}

map "$http_host" $uat_app_host_ok {
    "default" "0";
    "~^people\\-hub\\-uat\\.srv1866578\\.hstgr\\.cloud(?::443)?$" "1";
}

map "$http_host" $uat_api_host_ok {
    "default" "0";
    "~^supabase\\-uat\\.srv1866578\\.hstgr\\.cloud(?::443)?$" "1";
}

map "$http_host" $uat_private_host_ok {
    "default" "0";
    "uat-gateway:8080" "1";
}

map "$request_method" $uat_app_method_ok {
    "default" "0";
    "GET" "1";
    "HEAD" "1";
    "POST" "1";
}

map "$http_apikey" $uat_api_key {
    "default" "invalid";
    "~^\\Q${MAM_UAT_ANON_KEY}\\E$" "anon";
    "~^\\Q${MAM_UAT_SERVICE_ROLE_KEY}\\E$" "service";
}

map "$http_authorization" $uat_bearer {
    "default" "user";
    "" "absent";
    "~\\Q${MAM_UAT_SERVICE_ROLE_KEY}\\E" "service";
}

map "$uat_api_key:$uat_bearer" $uat_public_credential_ok {
    "default" "0";
    "anon:absent" "1";
    "anon:user" "1";
}

map "$request_method:$request_uri" $uat_login_rpc {
    "default" "0";
    "~^POST:/rest/v1/rpc/(?:claim_portal_login_attempt|resolve_portal_login_auth_email|clear_portal_login_rate_limit)$" "1";
}

map "$uat_api_key:$uat_bearer:$uat_login_rpc" $uat_private_credential_ok {
    "default" "0";
    "anon:absent:0" "1";
    "anon:absent:1" "1";
    "anon:user:0" "1";
    "anon:user:1" "1";
    "service:service:1" "1";
}

map "$uat_policy_method:$request_uri" $uat_auth_route {
    "default" "0";
    "~^POST:/auth/v1/token[?]grant_type=(?:password|refresh_token)$" "1";
    "~^POST:/auth/v1/logout(?:[?]scope=(?:local|global|others))?$" "1";
    "~^GET:/auth/v1/(?:user|settings|[.]well-known/jwks[.]json)$" "1";
}

map "$uat_policy_method:$request_uri" $uat_rest_route {
    "default" "0";
    "~^(?:GET|HEAD|POST):/rest/v1/(?:rpc/)?[a-z][a-z0-9_]*(?:[?].*)?$" "1";
}

server { listen 8081 default_server; server_name _; return 444; }

server { listen uat-gateway-private:8080 default_server; server_name _; return 444; }

server {
    listen 8081;
    server_name people-hub-uat.srv1866578.hstgr.cloud;
    if ($uat_app_host_ok = 0) { return 444; }
    if ($uat_origin_ok = 0) { return 403; }
    location / {
        if ($uat_app_method_ok = 0) { return 405; }
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_ignore_headers X-Accel-Redirect;
        proxy_buffering off;
        proxy_redirect off;
        proxy_pass http://uat_web;
    }
}

