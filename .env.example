# Browser-safe values. Use a development Supabase project or branch locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key used exclusively by authenticated account-
# admin Server Actions. Never expose this value through NEXT_PUBLIC_* or logs.
SUPABASE_SECRET_KEY=

# Exact production origin used for in-app links, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login passwords are stored only by Supabase Auth. Existing passwords cannot be
# retrieved. Never add a password or secret/service-role value to this template.
