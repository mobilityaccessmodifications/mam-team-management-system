# Browser-safe values. Use a development Supabase project or branch locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SHARED_DEMO=false

# Local E2E only. When true, server startup requires loopback app/Supabase URLs,
# required local keys, no outbound integration variables, and loopback-only fetch.
MAM_SANDBOX_E2E=false

# Exact origin used for magic-link redirects, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only optional allowlist. Confirm the final MAM domain before production.
MAM_ALLOWED_EMAIL_DOMAIN=mobilityaccess.com.au

# Never add SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY to this frontend template.

# Server-only AES-256-GCM key for encrypted subscription-service credentials.
# Generate a distinct 32-byte base64/base64url key for each environment; do not
# reuse a portal-login password or any Supabase key. The optional previous key
# variables are only for a controlled key-rotation window.
SUBSCRIPTION_CREDENTIAL_VAULT_KEY=
SUBSCRIPTION_CREDENTIAL_VAULT_KEY_VERSION=1
SUBSCRIPTION_CREDENTIAL_VAULT_PREVIOUS_KEY=
SUBSCRIPTION_CREDENTIAL_VAULT_PREVIOUS_KEY_VERSION=

# Server-only leave notifications. The receiver must accept only the
# server-derived recipient payload; browser input must never choose an email.
# Leave events cover submit, approve, decline and cancellation.
MAM_N8N_LEAVE_WEBHOOK_ORIGIN=
MAM_N8N_LEAVE_WEBHOOK_URL=
MAM_N8N_LEAVE_WEBHOOK_SECRET=

# Server-only check-in delivery and trusted document host. Resource links must
# share the exact HTTPS origin below; keep tenant paths out of source control.
CHECK_IN_RESOURCE_ORIGIN=
CHECK_IN_MANAGER_GUIDE_URL=
CHECK_IN_FORM_URL=
CHECK_IN_PROBATION_TEMPLATES_URL=
CHECK_IN_LEGACY_FORMS_FOLDER_URL=
N8N_CHECKIN_REMINDER_WEBHOOK_ORIGIN=
N8N_CHECKIN_REMINDER_WEBHOOK_URL=
N8N_CHECKIN_REMINDER_WEBHOOK_SECRET=
CRON_SECRET=

# Server-to-server bearer key for the read-only dashboard API at
# /api/analytics/v1. Generate a random value of at least 32 characters for
# each environment. Never put it in browser code, source control or a BI file.
MAM_ANALYTICS_API_KEY=

# Server-only OpenClaw phone allowlist integration. Provision 32 random bytes
# encoded base64url separately per environment; never reuse analytics/cron keys.
# Disabled (503) until configured. Never give OpenClaw SUPABASE_SECRET_KEY.
MAM_OPENCLAW_ALLOWLIST_SECRET=

# Draft WhatsApp self-leave bridge. Keep disabled until independently reviewed
# full-stack DB and trusted native-plugin confirmation tests pass.
MAM_OPENCLAW_LEAVE_ENABLED=false
MAM_OPENCLAW_LEAVE_ACCOUNT=
# Distinct 32-byte base64url secret; never reuse the allowlist/cron key.
MAM_OPENCLAW_LEAVE_BRIDGE_SECRET=

# Independent GitHub recovery scheduler; separate from the primary cron secret.
MAM_BACKGROUND_RECOVERY_SECRET=
