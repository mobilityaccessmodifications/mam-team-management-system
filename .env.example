# Browser-safe values. Use a development Supabase project or branch locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SHARED_DEMO=false

# Exact origin used for magic-link redirects, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only optional allowlist. Confirm the final MAM domain before production.
MAM_ALLOWED_EMAIL_DOMAIN=mobilityaccess.com.au

# Never add SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY to this frontend template.

# Server-only MAM HR test notifications. The receiver is fixed to HR and must
# never be supplied by browser input. Leave events are delivered for submit,
# approve, decline and cancellation; check-in reminders use their own vars.
MAM_N8N_LEAVE_WEBHOOK_URL=https://n8n.srv1866578.hstgr.cloud/webhook/mam-people-system-leave-hr-v1
MAM_N8N_LEAVE_WEBHOOK_SECRET=
