# Browser-safe values. Use a development Supabase project or branch locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SHARED_DEMO=false

# Exact origin used for magic-link redirects, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only optional allowlist. Confirm the final MAM domain before production.
MAM_ALLOWED_EMAIL_DOMAIN=mobilityaccess.com.au

# Server-only synthetic email-review transport. Keep disabled outside an approved
# Production test. The server and n8n workflow must hard-lock every physical
# delivery to ai@mobilityaccess.com.au; never put real employee addresses here.
MAM_DEMO_EMAIL_ENABLED=false
MAM_N8N_LEAVE_WEBHOOK_URL=
MAM_N8N_LEAVE_WEBHOOK_SECRET=

# Never add SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY to this frontend template.
